  RETURN
}

// ─── POS / COUNTER SALES ─────────────────────────────────────────────────

/**
 * One shift at the till — a drawer of cash that gets counted at the end.
 *
 * ── Why the totals are snapshots, not running counters ─────────────────────
 *
 * `saleCount`, `cashSalesPoisha` and the rest are null while the shift is open
 * and filled once at close. They are deliberately NOT incremented per sale:
 * a counter that is incremented on write drifts the first time a sale is
 * voided, a refund is booked, or a transaction is retried, and then the Z-report
 * is wrong in a way nobody can explain. The live figure is always derived from
 * the orders that point at this session (`pos.service.ts#sessionSummary`), so
 * there is one definition of "what this shift took".
 *
 * The snapshot exists for the opposite reason: once the drawer is counted and
 * the shift closed, the report must keep showing what was true at that moment,
 * even if an order is edited a month later.
 *
 * ── Why `expectedCashPoisha` and `countedCashPoisha` are separate ──────────
 *
 * Expected is what the system says should be in the drawer (float + cash sales).
 * Counted is what the cashier physically found. `variancePoisha` is the
 * difference, and it is the single most useful number in the module: a shop with
 * a persistent negative variance has a leak, and a shop that never looks has no
 * idea.
 */
model PosSession {
  id String @id @default(uuid())

  openedBy String
  openedAt DateTime @default(now())

  /** The float the drawer started with. Counted, not assumed. */
  openingCashPoisha Int @default(0)

  status PosSessionStatus @default(OPEN)

  closedBy String?
  closedAt DateTime?

  /** Cash physically counted at close. Null until then. */
  countedCashPoisha Int?
  /** Float + cash sales, computed at the moment of closing. */
  expectedCashPoisha Int?
  /** counted - expected. Negative means the drawer is short. */
  variancePoisha Int?

  /** Shift snapshot, written at close. Null while the shift is open. */
  saleCount        Int?
  cashSalesPoisha  Int?
  cardSalesPoisha  Int?
  otherSalesPoisha Int?

  note String? @db.Text

  orders Order[]

  @@index([status])
  @@index([openedAt])
  @@index([openedBy, status])
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

