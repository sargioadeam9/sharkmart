# SharkMart API - environment template
#
# Copy to `.env` and fill in. Never commit `.env` (it is gitignored).
# Every variable the server reads is listed here - AGENTS.md 7.11.
#
#   copy .env.example .env

# --- Runtime -------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Port the API binds. The storefront expects 4000 by default.
PORT=4000

# --- Database ------------------------------------------------------------
# MySQL 8 (or MariaDB 10.4+, which is what XAMPP ships).
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# The database must exist before `prisma migrate dev` runs.
DATABASE_URL=mysql://root:@localhost:3306/sharkmart

# --- CORS ----------------------------------------------------------------
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# --- Auth (Phase 8) ------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required once Phase 8 lands; optional until then.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Cache / queue (Phase 6) ---------------------------------------------
# Redis powers sessions, rate limiting and flash-sale timers.
REDIS_URL=redis://localhost:6379

# --- Object storage (Phase 13) -------------------------------------------
# S3-compatible bucket for product images. Leave blank to use local disk.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Logging -------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Courier & payment credentials (Phase 8 / 13) ------------------------
# Declared here so the shape is fixed. Never commit real values.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
REDX_API_KEY=
CARRYBEE_CLIENT_ID=
CARRYBEE_CLIENT_SECRET=

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# --- SMS & email (Phase 10) ----------------------------------------------
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@sharkmart.com.bd
# --- Internal service token (Phase 7) ------------------------------------
# Shared secret the Next server sends in X-Internal-Token so `next build`
# prerendering is not throttled by the public rate limit. Optional: leave blank
# and no request can bypass the limiter. Never expose this to a browser.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=
