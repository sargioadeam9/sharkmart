# SharkMart storefront - environment template
#
# Copy to `.env.local` and fill in. Next.js reads `.env.local` in development
# and it is gitignored. Never put a secret here: every NEXT_PUBLIC_ variable
# is inlined into the client bundle and is public.

# --- Mock switch ---------------------------------------------------------
# true  -> read fixtures from src/lib/mock (Phases 1-5)
# false -> read the real API at NEXT_PUBLIC_API_BASE_URL (Phase 6 onward)
NEXT_PUBLIC_USE_MOCK=true
# --- Dev preview strip ---------------------------------------------------
# true  -> render the reference's `.pv` developer navigation strip above the
#          top bar (Home / Category / Product / Brand / Cart shortcuts).
# false -> the strip is absent from the DOM entirely.
# Keep false in production. This is Phase 3 spec item #1.
NEXT_PUBLIC_SHOW_PREVIEW_STRIP=false


# --- API -----------------------------------------------------------------
# Base URL of the SharkMart API server. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Site ----------------------------------------------------------------
# Canonical origin, used for metadataBase, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://sharkmart.com.bd

# --- Analytics (Phase 11) ------------------------------------------------
# Public measurement IDs only. Never a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
# --- Internal service token (Phase 7) ------------------------------------
# Must match INTERNAL_API_TOKEN in server/.env. The Next server sends it in
# X-Internal-Token on server-side API calls only, so `next build` prerendering
# is not throttled by the public rate limit. Never expose this to a browser:
# it is NOT a NEXT_PUBLIC_ variable and must never be read in client code.
INTERNAL_API_TOKEN=
